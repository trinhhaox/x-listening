# Mật khẩu trang bàn nghe. Tối thiểu 8 ký tự.
ADMIN_PASSWORD=doi-mat-khau-nay

# Token riêng cho các hệ thống gọi /api/* (tối thiểu 16 ký tự). Để trống: API dùng ADMIN_PASSWORD.
# Nên đặt để không phải đưa mật khẩu admin cho crawler bên ngoài.
API_TOKEN=

# Khóa mã hóa cookie/token lưu trong DB (tối thiểu 16 ký tự). Để trống: dẫn xuất từ ADMIN_PASSWORD.
# Nên đặt để đổi ADMIN_PASSWORD không làm mất các khóa đã lưu. Đổi khóa này thì phải nhập lại khóa trong Cài đặt.
SECRETS_KEY=

# Bearer token ứng dụng X (Developer API). Nếu không có, dùng cookie bên dưới.
X_BEARER_TOKEN=

# COOKIE WEB X (KHÔNG CẦN TÀI KHOẢN DEVELOPER X, KHÔNG TỐN PHÍ $100/THÁNG)
# Mở x.com trên trình duyệt đã đăng nhập -> F12 -> Tab Application -> Cookies -> x.com
# Copy giá trị 2 cookie: 'auth_token' và 'ct0'
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Token đọc Trang Facebook (Graph API). Nếu không có, dùng cookie bên dưới.
FACEBOOK_ACCESS_TOKEN=

# COOKIE FACEBOOK (KHÔNG CẦN TẠO APP HAY XÉT DUYỆT META)
# Mở facebook.com trên trình duyệt -> F12 -> Network hoặc Application -> Copy toàn bộ chuỗi 'Cookie' (chứa c_user và xs)
FACEBOOK_COOKIE=

# Token Meta Threads API. Để trống nếu không nghe Threads.
THREADS_ACCESS_TOKEN=

# API Key cho YouTube Data API v3. Để trống nếu không nghe YouTube.
YOUTUBE_API_KEY=

# Chỉ nghe trên máy này.
HOST=127.0.0.1
PORT=3021
DATABASE_PATH=./data/listening.db

# Khoảng cách giữa các lần nghe tự động (phút). Tối thiểu 5.
LISTEN_INTERVAL_MINUTES=15
# Số bài tối đa mỗi lần hỏi X cho một chủ đề (10–100).
SEARCH_MAX_RESULTS=20

# 1: hồi chuông mới hiện thông báo trên máy Mac. 0: tắt.
DESKTOP_NOTIFY=1
# Để trống nếu không gửi ra ngoài. Chỉ nhận https, hoặc http://127.0.0.1.
ALERT_WEBHOOK_URL=

# Trí tuệ nhân tạo (OpenAI, Gemini OpenAI-compatible, Groq, Ollama...)
# Để trống: hệ thống dùng bộ từ điển Lexicon có sẵn.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
